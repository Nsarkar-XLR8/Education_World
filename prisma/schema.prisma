// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

// ─── Users & Auth ───────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  amountBks Decimal  @default(0) @db.Decimal(10, 2)
  amountNgd Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments       Comment[]
  cartItems      CartItem[]
  orders         Order[]
  sentMessages   Message[]        @relation("SentMessages")
  tuitionProfile TuitionProfile?
  loggedRecords  TuitionRecord[]  @relation("LoggedUser")
  addedRecords   TuitionRecord[]  @relation("AddedPerson")

  @@map("users")
}

// ─── Tuition System ─────────────────────────────────────

model TuitionProfile {
  id     Int    @id @default(autoincrement())
  name   String
  email  String @unique
  mobile String
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tuition_profiles")
}

model Student {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  address     String
  class       String
  dayTime     String
  slClgUn     String   // School / College / University
  subject     String
  designation String   // "student" or "teacher"
  salary      String?
  version     String?  // Bangla / English medium
  img         String?
  createdAt   DateTime @default(now())

  @@map("students")
}

model TuitionRecord {
  id               Int      @id @default(autoincrement())
  logUserId        Int
  logUserName      String
  logUserEmail     String
  logUserStatus    String
  logUserPhone     String
  logUserAddress   String
  logUserImg       String?
  logUserClass     String
  logUserSubject   String
  addPersonId      Int
  addPersonName    String
  addPersonEmail   String
  addPersonPhone   String
  addPersonStatus  String
  addPersonImg     String?
  addPersonTime    String
  addPersonClass   String
  addPersonSubject String
  createdAt        DateTime @default(now())

  logUser   User @relation("LoggedUser", fields: [logUserId], references: [id])
  addPerson User @relation("AddedPerson", fields: [addPersonId], references: [id])

  @@map("tuition_records")
}

// ─── Products & Commerce ────────────────────────────────

model Product {
  id             Int      @id @default(autoincrement())
  productName    String
  writerName     String
  productPrice   Decimal  @db.Decimal(10, 2)
  discount       Decimal  @default(0) @db.Decimal(5, 2)
  levelScClgUni  String   // "school" | "college" | "university" | "kids" | "others"
  stockProduct   Int      @default(0)
  img            String?
  createdAt      DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model CartItem {
  id              Int     @id @default(autoincrement())
  productId       Int
  customerEmail   String
  productQuantity Int     @default(1)
  eachProPrice    Decimal @db.Decimal(10, 2)
  totalPrice      Decimal @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [customerEmail], references: [email])

  @@map("cart_items")
}

model Order {
  id              Int         @id @default(autoincrement())
  customerEmail   String
  customerAddress String
  overallPrice    Decimal     @db.Decimal(10, 2)
  orderDate       DateTime    @default(now())
  status          OrderStatus @default(PENDING)

  customer User        @relation(fields: [customerEmail], references: [email])
  items    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id               Int     @id @default(autoincrement())
  orderId          Int
  productId        Int
  perProPrice      Decimal @db.Decimal(10, 2)
  proQuantity      Int
  perProTotalPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── Social Features ────────────────────────────────────

model Comment {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  userId    Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("comments")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  msg       String
  img       String?
  sendPhone String
  recPhone  String
  createdAt DateTime @default(now())

  sender User @relation("SentMessages", fields: [email], references: [email])

  @@map("messages")
}

// ─── Study Abroad ───────────────────────────────────────

model Abroad {
  id          Int      @id @default(autoincrement())
  rankUni     String
  university  String
  courseOffer  String
  tuitionFee  String
  livingCost  String
  fund        String
  internship  String
  taRaGa      String
  contact     String
  engPro      String   // English proficiency requirement
  score       String
  countryName String
  uniImg      String?
  cgpa        String
  createdAt   DateTime @default(now())

  @@map("abroad")
}
